# Server
NODE_ENV=development
# Must match the Vite dev proxy target (apps/*/vite.config.ts).
PORT=4000
# Browser-facing origin of the supervisor dev server.
APP_URL=http://localhost:5173
PROCESS_ROLE=both

# Data
# MongoDB must run as a replica set (share/archive use transactions).
MONGODB_URI=mongodb://127.0.0.1:27017/understood?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Secrets (generate real values for any deployed environment)
TOKEN_PEPPER=dev-pepper-change-me-0123456789
# base64-encoded 32 bytes; required in production
TOKEN_ENC_KEY=
# Optional platform operator activation API secret; generate at least 32 random characters.
# PLATFORM_OPERATOR_TOKEN=
# Optional browser push. Supply all three settings together.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Media: local | r2
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.data/media
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Email: console | resend
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=Understood <no-reply@understood.local>

# AI: mock | live
AI_DRIVER=mock
GROQ_API_KEY=
DEEPL_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Product limits
PIPELINE_ALL_LANGUAGES=true
TTS_MONTHLY_MINUTES=150
PREVIEW_TTL_MINUTES=15
MEDIA_URL_TTL_SECONDS=900
HELP_BATCH_SECONDS=600
RATE_LIMIT_ENABLED=true
