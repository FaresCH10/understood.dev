{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /healthz {
		reverse_proxy api:3000
	}

	handle_path /i/* {
		root * /srv/worker
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/supervisor
		try_files {path} /index.html
		file_server
	}
}
