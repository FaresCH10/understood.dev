# Copy to .env.production on the deployment host; never put real secrets in Git.
NODE_ENV=production
PORT=3000
APP_URL=https://app.example.com
DOMAIN=app.example.com
IMAGE=ghcr.io/faresch10/understood.dev:RELEASE_SHA
RELEASE_SHA=current
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/understood
REDIS_URL=redis://redis:6379
# Generate separate values: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_PEPPER=REPLACE_WITH_RANDOM_32_BYTE_SECRET
TOKEN_ENC_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
# Optional: random 32+ character secret; only for operator activation/payment administration.
# PLATFORM_OPERATOR_TOKEN=
MEDIA_DRIVER=r2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=understood-media
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_REGION=auto
EMAIL_DRIVER=resend
RESEND_API_KEY=REPLACE
EMAIL_FROM=Understood <no-reply@example.com>
AI_DRIVER=live
GROQ_API_KEY=REPLACE
# DEEPL_API_KEY=
AZURE_SPEECH_KEY=REPLACE
AZURE_SPEECH_REGION=uaenorth
PIPELINE_ALL_LANGUAGES=false
TTS_MONTHLY_MINUTES=150
PREVIEW_TTL_MINUTES=15
MEDIA_URL_TTL_SECONDS=900
HELP_BATCH_SECONDS=600
RATE_LIMIT_ENABLED=true
# Optional browser push: supply all three or leave all unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# Store backup key separately from TOKEN_ENC_KEY and the encrypted archive.
# BACKUP_ENCRYPTION_KEY=
